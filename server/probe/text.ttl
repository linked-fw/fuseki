# pg-test's shape over the module's type: a Lucene text index over lf:DatasetRDFSLive over TDB2.
PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ja:     <http://jena.hpl.hp.com/2005/11/Assembler#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>
PREFIX text:   <http://jena.apache.org/text#>
PREFIX schema: <http://schema.org/>
PREFIX lf:     <https://linked.cm/ont/fuseki#>
PREFIX :       <#>

:service a fuseki:Service ;
    fuseki:name "textprobe" ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:endpoint [ fuseki:operation lf:stored ; fuseki:name "stored" ] ;
    fuseki:dataset :text .

:text a text:TextDataset ; text:dataset :live ; text:index :lucene .
:live a lf:DatasetRDFSLive ; ja:dataset :tdb .
:tdb  a tdb2:DatasetTDB2 ; tdb2:location "/fuseki-base/databases/textprobe" .

:lucene a text:TextIndexLucene ;
    text:directory <file:/fuseki-base/databases/textprobe-lucene> ;
    text:storeValues true ;
    text:entityMap :map .
:map a text:EntityMap ;
    text:entityField "uri" ; text:graphField "graph" ; text:defaultField "text" ;
    text:uidField "uid" ; text:langField "lang" ;
    text:map ( [ text:field "text" ; text:predicate rdfs:label ]
               [ text:field "text" ; text:predicate schema:name ] ) .
